{
  "model": {
    "name": "ayan-123m", "block_size": 1024, "vocab_size": 32768,
    "padding_multiple": 1, "n_layer": 16, "n_embd": 768,
    "n_head": 12, "n_query_groups": 2, "intermediate_size": 2048,
    "norm_class_name": "RMSNorm", "norm_eps": 0.00001,
    "mlp_class_name": "LLaMAMLP", "rotary_percentage": 1.0,
    "rope_base": 10000, "parallel_residual": false,
    "shared_attention_norm": false, "bias": false, "lm_head_bias": false
  },
  "train": {
    "seed": 42, "seq_len": 1024, "global_batch": 128,
    "micro_batch": 4, "total_tokens": 15000000000,
    "lr": 0.0003, "min_lr": 0.00003, "warmup_fraction": 0.01,
    "decay_fraction": 0.1, "weight_decay": 0.1,
    "betas": [0.9, 0.95], "grad_clip": 1.0, "decay_mix": 0.1,
    "eval_steps": 100, "eval_batches": 8,
    "save_seconds": 1800, "hub_seconds": 3600,
