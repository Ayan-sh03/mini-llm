{
  "model": {
    "name": "smoke-only", "block_size": 64, "vocab_size": 512,
    "padding_multiple": 1, "n_layer": 2, "n_embd": 64,
    "n_head": 4, "n_query_groups": 2, "intermediate_size": 128,
    "norm_class_name": "RMSNorm", "mlp_class_name": "LLaMAMLP",
    "rotary_percentage": 1.0, "parallel_residual": false,
    "shared_attention_norm": false, "bias": false, "lm_head_bias": false
  },
  "train": {
    "seed": 42, "seq_len": 64, "global_batch": 4,
    "micro_batch": 2, "total_tokens": 25600,
    "lr": 0.001, "min_lr": 0.0001, "warmup_fraction": 0.05,
    "decay_fraction": 0.1, "weight_decay": 0.1,
    "betas": [0.9, 0.95], "grad_clip": 1.0, "decay_mix": 0.1,
    "eval_steps": 10, "eval_batches": 2,
    "save_seconds": 300, "hub_seconds": 3600,
    "log_steps": 1, "compile": false
  }
}
